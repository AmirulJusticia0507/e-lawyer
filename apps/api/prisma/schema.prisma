generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_URL_UNPOOLED")
  extensions = [vector, uuidOssp(map: "uuid-ossp"), pgcrypto]
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ClientType {
  PERSON
  ORGANIZATION
}

enum Jurisdiction {
  CIVIL
  CRIMINAL
  ADMINISTRATIVE
  RELIGIOUS
  MILITARY
  ARBITRATION
  OTHER
}

enum CaseStatus {
  NEW
  ACTIVE
  POSTPONED
  DECIDED
  CLOSED
  ARCHIVED
}

enum HearingStatus {
  SCHEDULED
  COMPLETED
  POSTPONED
  CANCELLED
}

enum PartySide {
  PLAINTIFF
  DEFENDANT
  APPLICANT
  RESPONDENT
  ACCUSED
  THIRD_PARTY
  OTHER
}

enum InteractionType {
  CALL
  EMAIL
  MEETING
  HEARING
  DOCUMENT
  OTHER
}

enum ConsultationMode {
  CHAT
  VIDEO
  PHONE
  IN_PERSON
}

enum ConsultationStatus {
  REQUESTED
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum MessageType {
  TEXT
  FILE
  SYSTEM
}

enum AttachmentScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum VideoSessionStatus {
  SCHEDULED
  ACTIVE
  ENDED
}

enum RegulationType {
  CONSTITUTION
  LAW
  GOVERNMENT_REGULATION
  PRESIDENTIAL_REGULATION
  MINISTERIAL_REGULATION
  SUPREME_COURT_REGULATION
  SUPREME_COURT_CIRCULAR
  CIVIL_CODE
  CRIMINAL_CODE
  PROCEDURAL_LAW
  LOCAL_REGULATION
  OTHER
}

enum LegalSourceStatus {
  DRAFT
  ACTIVE
  AMENDED
  REPEALED
  UNKNOWN
}

enum AmendmentType {
  AMENDS
  REPEALS
  REPLACES
  SUPPLEMENTS
}

enum CitationValidationStatus {
  PENDING
  VALID
  WARNING
  INVALID
}

enum CitationDocumentType {
  GUGATAN
  JAWABAN
  REPLIK
  DUPLIK
  KESIMPULAN
  PUTUSAN
  MEMO
  LAINNYA
}

enum DocumentType {
  POWER_OF_ATTORNEY
  COMPLAINT
  ANSWER
  REPLY
  DUPLICATION
  CONCLUSION
  JUDGMENT
  OTHER
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  SIGNED
  ARCHIVED
}

enum PowerOfAttorneyType {
  GENERAL
  SPECIFIC
  SPECIAL
}

enum SignatureStatus {
  PENDING
  SIGNED
  REVOKED
  FAILED
}

enum JudgmentVerdict {
  GRANTED
  REJECTED
  INADMISSIBLE
  SETTLED
  DEFAULT
  OTHER
}

enum JurisprudenceStatus {
  ACTIVE
  OVERRULED
  DISTINGUISHED
  UNKNOWN
}

enum IntegrityEntityType {
  ATTACHMENT
  ADDENDUM
  OFFICIAL_COPY
}

enum ReceiptStatus {
  SENT
  CONFIRMED
  DISPUTED
  EXPIRED
}

enum AnomalyType {
  UPLOAD_BURST
  BACKDATE_SUSPECT
  CLAIM_CHANGED
  DELAY_PATTERN
  HASH_MISMATCH
  DEADLINE_BREACH
  SLA_BREACH
  UNJUSTIFIED_POSTPONEMENT
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
}

enum AnomalyStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum DeadlineStatus {
  OPEN
  MET
  BREACHED
  CANCELLED
}

enum TimeEntryStatus {
  RUNNING
  STOPPED
}

enum FeeSchemeType {
  RETAINER
  HOURLY
  FIXED
  SUCCESS_FEE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  OVERDUE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum EscrowTransactionType {
  DEPOSIT
  RELEASE
  REFUND
  ADJUSTMENT
}

enum TaxType {
  PPH21
  PPH23
  PPN
  OTHER
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String
  fullName        String
  phone           String?
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]     @relation("AuditActor")

  clientsCreated      Client[]         @relation("ClientCreatedBy")
  interactionsCreated Interaction[]    @relation("InteractionCreatedBy")
  casesFiled          Case[]           @relation("CaseFiledBy")
  casesAssigned       Case[]           @relation("CaseAssignedTo")
  assignmentsMade     CaseAssignment[] @relation("CaseAssignmentMadeBy")
  assignmentsHistory  CaseAssignment[] @relation("CaseAssignmentFrom")
  assignmentsReceived CaseAssignment[] @relation("CaseAssignmentTo")
  feedbackGiven     Feedback[]         @relation("FeedbackGivenBy")

  consultationsRequested Consultation[] @relation("ConsultationRequestedBy")
  consultationsAssigned  Consultation[] @relation("ConsultationAssignedTo")
  messagesSent           Message[]      @relation("MessageSentBy")
  attachmentsUploaded    Attachment[]   @relation("AttachmentUploadedBy")

  integrityRecords       IntegrityRecord[]   @relation("IntegrityRecordedBy")
  integrityChecks        IntegrityCheck[]    @relation("IntegrityCheckedBy")
  addendaWritten         Addendum[]          @relation("AddendumAuthor")
  receiptsSent           DocumentReceipt[]   @relation("ReceiptSentBy")
  anomaliesResolved      AnomalyFlag[]       @relation("AnomalyResolvedBy")
  templatesCreated       Template[]          @relation("TemplateCreatedBy")
  documentsCreated       Document[]          @relation("DocumentCreatedBy")
  documentVersions       DocumentVersion[]   @relation("DocumentVersionCreatedBy")
  documentSignatures     Signature[]         @relation("SignatureSignedBy")
  powersOfAttorney       PowerOfAttorney[]   @relation("PowerOfAttorneyAttorney")
  judgmentsSigned        Judgment[]          @relation("JudgmentSignedBy")
  hearingsCreated        Hearing[]           @relation("HearingCreatedBy")
  postponementsRequested Postponement[]      @relation("PostponementRequestedBy")
  postponementsApproved  Postponement[]      @relation("PostponementApprovedBy")
  timeEntries            TimeEntry[]         @relation("TimeEntryUser")
  escrowTransactions     EscrowTransaction[] @relation("EscrowTransactionActor")

  @@index([status])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  action      String
  subject     String
  description String?

  roles RolePermission[]

  @@unique([action, subject])
  @@index([subject])
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Append-only audit trail. Rows are never updated or deleted.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  subject   String
  subjectId String?
  method    String?
  path      String?
  status    Int?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([subject])
  @@index([action])
  @@index([createdAt])
}

model Client {
  id          String     @id @default(uuid()) @db.Uuid
  type        ClientType @default(PERSON)
  fullName    String
  nik         String?    @unique
  npwp        String?
  email       String?
  phone       String?
  address     Json?
  notes       String?
  createdById String?    @db.Uuid
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdBy        User?             @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  parties          Party[]
  interactions     Interaction[]
  consultations    Consultation[]
  powersOfAttorney PowerOfAttorney[]
  feeSchemes       FeeScheme[]
  invoices         Invoice[]
  escrowAccounts   Escrow[]

  @@index([fullName])
  @@index([createdById])
  @@index([email])
  @@index([phone])
}

model Case {
  id               String       @id @default(uuid()) @db.Uuid
  caseNumber       String       @unique
  title            String
  description      String?
  courtName        String?
  jurisdiction     Jurisdiction @default(CIVIL)
  caseType         String?
  status           CaseStatus   @default(NEW)
  filedAt          DateTime?
  decidedAt        DateTime?
  filedByUserId    String?      @db.Uuid
  assignedToUserId String?      @db.Uuid
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  filedBy       User?            @relation("CaseFiledBy", fields: [filedByUserId], references: [id], onDelete: SetNull)
  assignedTo    User?            @relation("CaseAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  parties       Party[]
  interactions  Interaction[]
  assignments   CaseAssignment[]
  consultations Consultation[]
  citations     Citation[]

  integrityRecords IntegrityRecord[]
  addenda          Addendum[]
  receipts         DocumentReceipt[]
  deadlines        CaseDeadline[]
  anomalies        AnomalyFlag[]
  documents        Document[]
  hearings         Hearing[]
  timeEntries      TimeEntry[]
  feeSchemes       FeeScheme[]
  invoices         Invoice[]
  escrowAccounts   Escrow[]
  feedbackGiven    Feedback[]        @relation("FeedbackGivenBy")

  @@index([filedByUserId])
  @@index([assignedToUserId])
  @@index([status])
  @@index([jurisdiction])
  @@index([courtName])
}

model TimeEntry {
  id              String          @id @default(uuid()) @db.Uuid
  caseId          String          @db.Uuid
  userId          String          @db.Uuid
  description     String
  status          TimeEntryStatus @default(STOPPED)
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int?
  hourlyRate      Decimal?        @db.Decimal(18, 2)
  amount          Decimal?        @db.Decimal(18, 2)
  billable        Boolean         @default(true)
  invoicedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  case        Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user        User         @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Restrict)
  invoiceItem InvoiceItem?

  @@index([caseId, startedAt])
  @@index([userId, startedAt])
  @@index([status])
}

model Feedback {
  id              String          @id @default(uuid()) @db.Uuid
  caseId          String?         @db.Uuid
  userId          String          @db.Uuid
  predictionType  String          // 'case_strength', 'verdict_prediction', 'citations'
  predictedValue  String
  actualOutcome   String?
  rating          Int?            // 1-5 scale
  feedbackText    String?
  createdAt       DateTime        @default(now())
  user          User          @relation("FeedbackGivenBy", fields: [userId], references: [id], onDelete: SetNull)
  case        Case?         @relation("FeedbackGivenBy", fields: [caseId], references: [id], onDelete: SetNull)
}

model FeeScheme {
  id                String        @id @default(uuid()) @db.Uuid
  caseId            String?       @db.Uuid
  clientId          String?       @db.Uuid
  type              FeeSchemeType
  name              String
  currency          String        @default("IDR")
  amount            Decimal?      @db.Decimal(18, 2)
  hourlyRate        Decimal?      @db.Decimal(18, 2)
  successPercentage Decimal?      @db.Decimal(5, 2)
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  case   Case?   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([caseId, active])
  @@index([clientId, active])
}

model Invoice {
  id         String        @id @default(uuid()) @db.Uuid
  invoiceNo  String        @unique
  caseId     String        @db.Uuid
  clientId   String        @db.Uuid
  status     InvoiceStatus @default(DRAFT)
  currency   String        @default("IDR")
  subtotal   Decimal       @default(0) @db.Decimal(18, 2)
  taxAmount  Decimal       @default(0) @db.Decimal(18, 2)
  total      Decimal       @default(0) @db.Decimal(18, 2)
  paidAmount Decimal       @default(0) @db.Decimal(18, 2)
  issuedAt   DateTime?
  dueAt      DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  case               Case                @relation(fields: [caseId], references: [id], onDelete: Restrict)
  client             Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  items              InvoiceItem[]
  payments           Payment[]
  taxes              TaxRecord[]
  escrowTransactions EscrowTransaction[]

  @@index([caseId, status])
  @@index([clientId, status])
  @@index([dueAt])
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  timeEntryId String?  @unique @db.Uuid
  description String
  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(18, 2)
  amount      Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now())

  invoice   Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  timeEntry TimeEntry? @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  invoiceId String        @db.Uuid
  reference String?       @unique
  status    PaymentStatus @default(PENDING)
  method    String
  amount    Decimal       @db.Decimal(18, 2)
  paidAt    DateTime?
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId, status])
}

model Escrow {
  id        String   @id @default(uuid()) @db.Uuid
  caseId    String   @db.Uuid
  clientId  String   @db.Uuid
  currency  String   @default("IDR")
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case         Case                @relation(fields: [caseId], references: [id], onDelete: Restrict)
  client       Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  transactions EscrowTransaction[]

  @@unique([caseId, clientId, currency])
  @@index([clientId])
}

model EscrowTransaction {
  id           String                @id @default(uuid()) @db.Uuid
  escrowId     String                @db.Uuid
  invoiceId    String?               @db.Uuid
  actorId      String?               @db.Uuid
  type         EscrowTransactionType
  amount       Decimal               @db.Decimal(18, 2)
  balanceAfter Decimal               @db.Decimal(18, 2)
  milestone    String?
  notes        String?
  createdAt    DateTime              @default(now())

  escrow  Escrow   @relation(fields: [escrowId], references: [id], onDelete: Restrict)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  actor   User?    @relation("EscrowTransactionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([escrowId, createdAt])
  @@index([invoiceId])
}

model TaxRecord {
  id         String   @id @default(uuid()) @db.Uuid
  invoiceId  String   @db.Uuid
  type       TaxType
  rate       Decimal  @db.Decimal(5, 2)
  taxBase    Decimal  @db.Decimal(18, 2)
  amount     Decimal  @db.Decimal(18, 2)
  externalId String?
  createdAt  DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, type])
}

model Hearing {
  id          String        @id @default(uuid()) @db.Uuid
  caseId      String        @db.Uuid
  startsAt    DateTime
  endsAt      DateTime
  courtroom   String
  judgeName   String
  status      HearingStatus @default(SCHEDULED)
  notes       String?
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  case          Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy     User?          @relation("HearingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  slaTimers     HearingSla[]
  postponements Postponement[]
  reminders     Reminder[]

  @@index([startsAt, endsAt, status])
  @@index([courtroom, startsAt, endsAt])
  @@index([judgeName, startsAt, endsAt])
  @@index([caseId, startsAt])
}

enum HearingStage {
  PERSIANGAN
  PEMBUKTIAN
  PEMBAHASAN
  PUTUSAN
}

enum SlaStatus {
  ON_TRACK
  AT_RISK
  BREACHED
  COMPLETED
}

enum PostponementStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReminderType {
  H7
  H3
  H1
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

model HearingSla {
  id          String       @id @default(uuid()) @db.Uuid
  hearingId   String       @db.Uuid
  hearing     Hearing      @relation(fields: [hearingId], references: [id], onDelete: Cascade)
  stage       HearingStage
  label       String
  startedAt   DateTime
  deadlineAt  DateTime
  completedAt DateTime?
  status      SlaStatus    @default(ON_TRACK)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  SlaAlert    SlaAlert[]

  @@index([hearingId])
  @@index([status])
  @@index([deadlineAt])
}

model SlaAlert {
  id             String     @id @default(uuid()) @db.Uuid
  slaTimerId     String     @db.Uuid
  slaTimer       HearingSla @relation(fields: [slaTimerId], references: [id], onDelete: Cascade)
  level          String
  message        String
  triggeredAt    DateTime   @default(now())
  acknowledgedAt DateTime?

  @@index([slaTimerId])
  @@index([level])
}

model Postponement {
  id             String             @id @default(uuid()) @db.Uuid
  hearingId      String             @db.Uuid
  hearing        Hearing            @relation(fields: [hearingId], references: [id], onDelete: Cascade)
  reason         String
  requestedById  String?            @db.Uuid
  requestedBy    User?              @relation("PostponementRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById   String?            @db.Uuid
  approvedBy     User?              @relation("PostponementApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  status         PostponementStatus @default(PENDING)
  extensionCount Int                @default(0)
  newStartsAt    DateTime?
  newEndsAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([hearingId])
  @@index([status])
}

model Reminder {
  id        String         @id @default(uuid()) @db.Uuid
  hearingId String         @db.Uuid
  hearing   Hearing        @relation(fields: [hearingId], references: [id], onDelete: Cascade)
  type      ReminderType
  triggerAt DateTime
  status    ReminderStatus @default(PENDING)
  channel   String         @default("push")
  sentAt    DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([hearingId])
  @@index([type])
  @@index([status])
}

model Party {
  id          String     @id @default(uuid()) @db.Uuid
  caseId      String     @db.Uuid
  clientId    String?    @db.Uuid
  side        PartySide  @default(OTHER)
  name        String
  type        ClientType @default(PERSON)
  nik         String?
  npwp        String?
  email       String?
  phone       String?
  address     Json?
  isMainParty Boolean    @default(false)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  case   Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  receipts DocumentReceipt[]

  @@unique([caseId, side, name])
  @@index([clientId])
}

model Interaction {
  id          String          @id @default(uuid()) @db.Uuid
  caseId      String          @db.Uuid
  clientId    String?         @db.Uuid
  type        InteractionType @default(OTHER)
  title       String
  description String?
  occurredAt  DateTime        @default(now())
  createdById String?         @db.Uuid
  createdAt   DateTime        @default(now())

  case      Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("InteractionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([clientId])
  @@index([createdById])
  @@index([occurredAt])
}

model CaseAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  caseId       String   @db.Uuid
  fromUserId   String?  @db.Uuid
  toUserId     String   @db.Uuid
  assignedById String?  @db.Uuid
  note         String?
  createdAt    DateTime @default(now())

  case       Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromUser   User? @relation("CaseAssignmentFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser     User? @relation("CaseAssignmentTo", fields: [toUserId], references: [id], onDelete: SetNull)
  assignedBy User? @relation("CaseAssignmentMadeBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([toUserId])
}

model Consultation {
  id               String             @id @default(uuid()) @db.Uuid
  clientId         String             @db.Uuid
  caseId           String?            @db.Uuid
  requestedById    String?            @db.Uuid
  assignedToUserId String?            @db.Uuid
  subject          String
  description      String?
  mode             ConsultationMode   @default(CHAT)
  status           ConsultationStatus @default(REQUESTED)
  scheduledAt      DateTime?
  durationMinutes  Int?
  closedAt         DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case             Case?             @relation(fields: [caseId], references: [id], onDelete: SetNull)
  requestedBy      User?             @relation("ConsultationRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  assignedTo       User?             @relation("ConsultationAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages         Message[]
  attachments      Attachment[]
  videoSessions    VideoSession[]
  integrityRecords IntegrityRecord[]

  @@index([clientId])
  @@index([caseId])
  @@index([assignedToUserId])
  @@index([status])
  @@index([scheduledAt])
}

// Pesan terenkripsi end-to-end. Server hanya menyimpan ciphertext + metadata.
model Message {
  id             String      @id @default(uuid()) @db.Uuid
  consultationId String      @db.Uuid
  senderId       String?     @db.Uuid
  type           MessageType @default(TEXT)
  body           String?
  ciphertext     String?
  iv             String?
  algorithm      String?
  createdAt      DateTime    @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  sender       User?        @relation("MessageSentBy", fields: [senderId], references: [id], onDelete: SetNull)
  attachments  Attachment[]

  @@index([consultationId])
  @@index([senderId])
  @@index([createdAt])
}

model Attachment {
  id             String               @id @default(uuid()) @db.Uuid
  consultationId String               @db.Uuid
  messageId      String?              @db.Uuid
  uploaderId     String?              @db.Uuid
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String               @unique
  sha256         String
  scanStatus     AttachmentScanStatus @default(PENDING)
  createdAt      DateTime             @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploader     User?        @relation("AttachmentUploadedBy", fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([consultationId])
  @@index([messageId])
  @@index([sha256])
}

model VideoSession {
  id             String             @id @default(uuid()) @db.Uuid
  consultationId String             @db.Uuid
  roomId         String             @unique
  provider       String             @default("webrtc")
  status         VideoSessionStatus @default(SCHEDULED)
  startedAt      DateTime?
  endedAt        DateTime?
  recordingKey   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@index([status])
}

model Regulation {
  id             String            @id @default(uuid()) @db.Uuid
  slug           String            @unique
  type           RegulationType
  number         String?
  year           Int?
  title          String
  jurisdiction   Jurisdiction?
  status         LegalSourceStatus @default(UNKNOWN)
  issuedAt       DateTime?
  effectiveFrom  DateTime?
  effectiveUntil DateTime?
  sourceUrl      String?
  sourceName     String?
  checksum       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Kolom basis pengindeksan full-text & semantik dikelola lewat migrasi SQL.
  searchVector Unsupported("tsvector")?
  embedding    Unsupported("vector(1536)")?

  articles           Article[]
  amendmentsMade     Amendment[] @relation("AmendingRegulation")
  amendmentsReceived Amendment[] @relation("AmendedRegulation")

  @@index([type, number, year])
  @@index([jurisdiction])
  @@index([status])
  @@index([effectiveFrom, effectiveUntil])
}

model Article {
  id              String            @id @default(uuid()) @db.Uuid
  regulationId    String            @db.Uuid
  unitKey         String
  articleNumber   String
  paragraphNumber String?
  heading         String?
  content         String
  status          LegalSourceStatus @default(ACTIVE)
  effectiveFrom   DateTime?
  effectiveUntil  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Kolom basis pengindeksan full-text & semantik dikelola lewat migrasi SQL.
  searchVector Unsupported("tsvector")?
  embedding    Unsupported("vector(1536)")?

  regulation Regulation  @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  amendments Amendment[]
  citations  Citation[]

  @@unique([regulationId, unitKey])
  @@index([regulationId, articleNumber])
  @@index([status])
  @@index([effectiveFrom, effectiveUntil])
}

model Amendment {
  id                   String        @id @default(uuid()) @db.Uuid
  amendingRegulationId String        @db.Uuid
  amendedRegulationId  String        @db.Uuid
  articleId            String?       @db.Uuid
  type                 AmendmentType @default(AMENDS)
  effectiveAt          DateTime?
  note                 String?
  createdAt            DateTime      @default(now())

  amendingRegulation Regulation @relation("AmendingRegulation", fields: [amendingRegulationId], references: [id], onDelete: Restrict)
  amendedRegulation  Regulation @relation("AmendedRegulation", fields: [amendedRegulationId], references: [id], onDelete: Restrict)
  article            Article?   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([amendingRegulationId, amendedRegulationId, articleId, type])
  @@index([amendedRegulationId])
  @@index([articleId])
  @@index([effectiveAt])
}

model Jurisprudence {
  id                 String              @id @default(uuid()) @db.Uuid
  decisionNumber     String
  courtName          String
  jurisdiction       Jurisdiction
  decisionDate       DateTime
  caseClassification String?
  judges             String[]
  summary            String?
  legalHolding       String?
  fullText           String?
  sourceUrl          String?
  checksum           String?
  status             JurisprudenceStatus @default(UNKNOWN)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Kolom basis pengindeksan full-text & semantik dikelola lewat migrasi SQL.
  searchVector Unsupported("tsvector")?
  embedding    Unsupported("vector(1536)")?

  citations Citation[]

  @@unique([courtName, decisionNumber])
  @@index([jurisdiction])
  @@index([decisionDate])
  @@index([status])
}

model Citation {
  id                String                   @id @default(uuid()) @db.Uuid
  articleId         String                   @db.Uuid
  caseId            String?                  @db.Uuid
  jurisprudenceId   String?                  @db.Uuid
  quote             String?
  context           String?
  documentType      CitationDocumentType?
  documentTitle     String?
  validationStatus  CitationValidationStatus @default(PENDING)
  validationMessage String?
  validatedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  article       Article        @relation(fields: [articleId], references: [id], onDelete: Restrict)
  case          Case?          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  jurisprudence Jurisprudence? @relation(fields: [jurisprudenceId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([caseId])
  @@index([jurisprudenceId])
  @@index([validationStatus])
  @@index([documentType])
}

// Ledger integritas: satu baris per berkas/dokumen yang di-hash.
// Append-only â€” baris tidak pernah diubah/dihapus (ditegakkan trigger DB).
model IntegrityRecord {
  id             String              @id @default(uuid()) @db.Uuid
  entityType     IntegrityEntityType
  entityId       String              @db.Uuid
  caseId         String?             @db.Uuid
  consultationId String?             @db.Uuid
  sha256         String
  algorithm      String              @default("sha256")
  sizeBytes      Int?
  storageKey     String?
  tsaToken       String?
  tsaUrl         String?
  anchorHash     String?
  anchoredAt     DateTime?
  metadata       Json?
  recordedById   String?             @db.Uuid
  createdAt      DateTime            @default(now())

  case         Case?         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  recordedBy   User?         @relation("IntegrityRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  checks    IntegrityCheck[]
  addenda   Addendum[]
  receipts  DocumentReceipt[]
  anomalies AnomalyFlag[]

  @@unique([entityType, entityId])
  @@index([caseId])
  @@index([consultationId])
  @@index([sha256])
  @@index([createdAt])
}

enum IntegrityCheckResult {
  MATCH
  MISMATCH
  MISSING_FILE
}

// Hasil verifikasi ulang integritas (bandingkan hash tersimpan vs isi berkas saat ini).
model IntegrityCheck {
  id             String               @id @default(uuid()) @db.Uuid
  recordId       String               @db.Uuid
  expectedSha256 String
  actualSha256   String?
  result         IntegrityCheckResult
  note           String?
  checkedById    String?              @db.Uuid
  createdAt      DateTime             @default(now())

  record    IntegrityRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  checkedBy User?           @relation("IntegrityCheckedBy", fields: [checkedById], references: [id], onDelete: SetNull)

  @@index([recordId])
  @@index([result])
  @@index([createdAt])
}

// Dokumen bersifat immutable setelah submit; revisi hanya melalui Addendum.
model Addendum {
  id        String   @id @default(uuid()) @db.Uuid
  caseId    String   @db.Uuid
  recordId  String   @db.Uuid
  authorId  String?  @db.Uuid
  title     String
  content   String
  createdAt DateTime @default(now())

  case   Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  record IntegrityRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  author User?           @relation("AddendumAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([recordId])
  @@index([createdAt])
}

// Dual-confirmation: pihak lawan menerima salinan resmi + konfirmasi terima.
model DocumentReceipt {
  id               String        @id @default(uuid()) @db.Uuid
  caseId           String        @db.Uuid
  recordId         String        @db.Uuid
  recipientPartyId String        @db.Uuid
  senderId         String?       @db.Uuid
  status           ReceiptStatus @default(SENT)
  token            String        @unique
  sentAt           DateTime      @default(now())
  confirmedAt      DateTime?
  confirmNote      String?

  case           Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  record         IntegrityRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  recipientParty Party           @relation(fields: [recipientPartyId], references: [id], onDelete: Cascade)
  sender         User?           @relation("ReceiptSentBy", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([recordId])
  @@index([recipientPartyId])
  @@index([status])
}

model AnomalyFlag {
  id             String          @id @default(uuid()) @db.Uuid
  type           AnomalyType
  severity       AnomalySeverity @default(MEDIUM)
  status         AnomalyStatus   @default(OPEN)
  caseId         String?         @db.Uuid
  recordId       String?         @db.Uuid
  subject        String
  subjectId      String?
  message        String
  details        Json?
  resolvedById   String?         @db.Uuid
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime        @default(now())

  case       Case?            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  record     IntegrityRecord? @relation(fields: [recordId], references: [id], onDelete: Cascade)
  resolvedBy User?            @relation("AnomalyResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([recordId])
  @@index([type])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

// Enforcement deadline otomatis: keterlambatan ditandai sistem, perpanjangan wajib beralasan.
model CaseDeadline {
  id                  String         @id @default(uuid()) @db.Uuid
  caseId              String         @db.Uuid
  label               String
  dueAt               DateTime
  status              DeadlineStatus @default(OPEN)
  extensionCount      Int            @default(0)
  lastExtensionReason String?
  extendedAt          DateTime?
  breachedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([status])
  @@index([dueAt])
}

model Template {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  documentType DocumentType
  jurisdiction Jurisdiction
  version      Int          @default(1)
  content      String       @db.Text
  structure    Json?
  isActive     Boolean      @default(true)
  createdById  String?      @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  createdBy User?      @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  documents Document[]

  @@unique([name, version, jurisdiction])
  @@index([documentType, jurisdiction, isActive])
  @@index([createdById])
}

model Document {
  id          String         @id @default(uuid()) @db.Uuid
  caseId      String         @db.Uuid
  templateId  String?        @db.Uuid
  createdById String?        @db.Uuid
  type        DocumentType
  status      DocumentStatus @default(DRAFT)
  title       String
  content     String         @db.Text
  data        Json?
  storageKey  String?        @unique
  sha256      String?
  submittedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  case            Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  template        Template?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy       User?             @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  versions        DocumentVersion[]
  signatures      Signature[]
  powerOfAttorney PowerOfAttorney?
  judgment        Judgment?

  @@index([caseId, type, status])
  @@index([templateId])
  @@index([createdById])
  @@index([sha256])
}

model DocumentVersion {
  id            String   @id @default(uuid()) @db.Uuid
  documentId    String   @db.Uuid
  version       Int
  content       String   @db.Text
  data          Json?
  changeSummary String?
  createdById   String?  @db.Uuid
  createdAt     DateTime @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("DocumentVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([documentId, version])
  @@index([createdById])
}

model Signature {
  id            String          @id @default(uuid()) @db.Uuid
  documentId    String          @db.Uuid
  signerId      String?         @db.Uuid
  signerName    String
  signerRole    String
  status        SignatureStatus @default(PENDING)
  method        String?
  signatureHash String?
  certificateId String?
  metadata      Json?
  signedAt      DateTime?
  createdAt     DateTime        @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signer   User?    @relation("SignatureSignedBy", fields: [signerId], references: [id], onDelete: SetNull)

  @@index([documentId, status])
  @@index([signerId])
}

model PowerOfAttorney {
  id                String              @id @default(uuid()) @db.Uuid
  documentId        String              @unique @db.Uuid
  clientId          String?             @db.Uuid
  attorneyUserId    String?             @db.Uuid
  type              PowerOfAttorneyType
  principalName     String
  principalNik      String?
  principalNpwp     String?
  attorneyName      String
  attorneyLicenseNo String?
  attorneyNpwp      String?
  authority         Json?
  validFrom         DateTime?
  validUntil        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  attorneyUser User?    @relation("PowerOfAttorneyAttorney", fields: [attorneyUserId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([attorneyUserId])
  @@index([type, validUntil])
}

model Judgment {
  id              String          @id @default(uuid()) @db.Uuid
  documentId      String          @unique @db.Uuid
  signedByUserId  String?         @db.Uuid
  verdict         JudgmentVerdict @default(OTHER)
  header          Json?
  partyIdentities Json?
  caseSummary     String          @db.Text
  considerations  String          @db.Text
  disposition     String          @db.Text
  closing         String          @db.Text
  publishedAt     DateTime?
  anonymizedAt    DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signedBy User?    @relation("JudgmentSignedBy", fields: [signedByUserId], references: [id], onDelete: SetNull)

  @@index([signedByUserId])
  @@index([publishedAt])
}
