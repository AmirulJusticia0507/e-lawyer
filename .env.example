# Application
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3001

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://elawyer:elawyer@localhost:5432/elawyer?schema=public
POSTGRES_PORT=5432

# Redis (session, cache, queue)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Auth
JWT_ACCESS_SECRET=changeme-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# OAuth2
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Storage (S3 / GCS)
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Encryption
ENCRYPTION_KEY=changeme-aes256-key

# Trusted Timestamp & Integrity
TSA_URL=
INTEGRITY_HASH_ALGO=sha256

# AI / LLM
AI_PROVIDER=
AI_API_KEY=
AI_EMBEDDING_MODEL=
AI_VECTOR_DIM=1536

# E-Signature & E-Meterai
ESIGN_PROVIDER=
ESIGN_API_KEY=
EMETERAI_API_KEY=

# Payment Gateway & Escrow
PAYMENT_PROVIDER=
PAYMENT_SERVER_KEY=
ESCROW_ACCOUNT_ID=

# Notification
SMTP_URL=
WHATSAPP_API_KEY=
PUSH_PROVIDER_KEY=

# Video Conference
VIDEO_PROVIDER=
VIDEO_API_KEY=
