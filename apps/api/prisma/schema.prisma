generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, uuidOssp(map: "uuid-ossp"), pgcrypto]
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ClientType {
  PERSON
  ORGANIZATION
}

enum Jurisdiction {
  CIVIL
  CRIMINAL
  ADMINISTRATIVE
  RELIGIOUS
  MILITARY
  ARBITRATION
  OTHER
}

enum CaseStatus {
  NEW
  ACTIVE
  POSTPONED
  DECIDED
  CLOSED
  ARCHIVED
}

enum PartySide {
  PLAINTIFF
  DEFENDANT
  APPLICANT
  RESPONDENT
  ACCUSED
  THIRD_PARTY
  OTHER
}

enum InteractionType {
  CALL
  EMAIL
  MEETING
  HEARING
  DOCUMENT
  OTHER
}

enum ConsultationMode {
  CHAT
  VIDEO
  PHONE
  IN_PERSON
}

enum ConsultationStatus {
  REQUESTED
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum MessageType {
  TEXT
  FILE
  SYSTEM
}

enum AttachmentScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum VideoSessionStatus {
  SCHEDULED
  ACTIVE
  ENDED
}

enum RegulationType {
  CONSTITUTION
  LAW
  GOVERNMENT_REGULATION
  PRESIDENTIAL_REGULATION
  MINISTERIAL_REGULATION
  SUPREME_COURT_REGULATION
  SUPREME_COURT_CIRCULAR
  CIVIL_CODE
  CRIMINAL_CODE
  PROCEDURAL_LAW
  LOCAL_REGULATION
  OTHER
}

enum LegalSourceStatus {
  DRAFT
  ACTIVE
  AMENDED
  REPEALED
  UNKNOWN
}

enum AmendmentType {
  AMENDS
  REPEALS
  REPLACES
  SUPPLEMENTS
}

enum CitationValidationStatus {
  PENDING
  VALID
  WARNING
  INVALID
}

enum JurisprudenceStatus {
  ACTIVE
  OVERRULED
  DISTINGUISHED
  UNKNOWN
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String
  fullName        String
  phone           String?
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]     @relation("AuditActor")

  clientsCreated      Client[]         @relation("ClientCreatedBy")
  interactionsCreated Interaction[]    @relation("InteractionCreatedBy")
  casesFiled          Case[]           @relation("CaseFiledBy")
  casesAssigned       Case[]           @relation("CaseAssignedTo")
  assignmentsMade     CaseAssignment[] @relation("CaseAssignmentMadeBy")
  assignmentsHistory  CaseAssignment[] @relation("CaseAssignmentFrom")
  assignmentsReceived CaseAssignment[] @relation("CaseAssignmentTo")

  consultationsRequested Consultation[] @relation("ConsultationRequestedBy")
  consultationsAssigned  Consultation[] @relation("ConsultationAssignedTo")
  messagesSent           Message[]      @relation("MessageSentBy")
  attachmentsUploaded    Attachment[]   @relation("AttachmentUploadedBy")

  @@index([status])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  action      String
  subject     String
  description String?

  roles RolePermission[]

  @@unique([action, subject])
  @@index([subject])
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Append-only audit trail. Rows are never updated or deleted.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  subject   String
  subjectId String?
  method    String?
  path      String?
  status    Int?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([subject])
  @@index([action])
  @@index([createdAt])
}

model Client {
  id          String     @id @default(uuid()) @db.Uuid
  type        ClientType @default(PERSON)
  fullName    String
  nik         String?    @unique
  npwp        String?
  email       String?
  phone       String?
  address     Json?
  notes       String?
  createdById String?    @db.Uuid
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdBy     User?          @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  parties       Party[]
  interactions  Interaction[]
  consultations Consultation[]

  @@index([fullName])
  @@index([createdById])
  @@index([email])
  @@index([phone])
}

model Case {
  id               String       @id @default(uuid()) @db.Uuid
  caseNumber       String       @unique
  title            String
  description      String?
  courtName        String?
  jurisdiction     Jurisdiction @default(CIVIL)
  caseType         String?
  status           CaseStatus   @default(NEW)
  filedAt          DateTime?
  decidedAt        DateTime?
  filedByUserId    String?      @db.Uuid
  assignedToUserId String?      @db.Uuid
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  filedBy       User?            @relation("CaseFiledBy", fields: [filedByUserId], references: [id], onDelete: SetNull)
  assignedTo    User?            @relation("CaseAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  parties       Party[]
  interactions  Interaction[]
  assignments   CaseAssignment[]
  consultations Consultation[]
  citations     Citation[]

  @@index([filedByUserId])
  @@index([assignedToUserId])
  @@index([status])
  @@index([jurisdiction])
  @@index([courtName])
}

model Party {
  id          String     @id @default(uuid()) @db.Uuid
  caseId      String     @db.Uuid
  clientId    String?    @db.Uuid
  side        PartySide  @default(OTHER)
  name        String
  type        ClientType @default(PERSON)
  nik         String?
  npwp        String?
  email       String?
  phone       String?
  address     Json?
  isMainParty Boolean    @default(false)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  case   Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([caseId, side, name])
  @@index([clientId])
}

model Interaction {
  id          String          @id @default(uuid()) @db.Uuid
  caseId      String          @db.Uuid
  clientId    String?         @db.Uuid
  type        InteractionType @default(OTHER)
  title       String
  description String?
  occurredAt  DateTime        @default(now())
  createdById String?         @db.Uuid
  createdAt   DateTime        @default(now())

  case      Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("InteractionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([clientId])
  @@index([createdById])
  @@index([occurredAt])
}

model CaseAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  caseId       String   @db.Uuid
  fromUserId   String?  @db.Uuid
  toUserId     String   @db.Uuid
  assignedById String?  @db.Uuid
  note         String?
  createdAt    DateTime @default(now())

  case       Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromUser   User? @relation("CaseAssignmentFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser     User? @relation("CaseAssignmentTo", fields: [toUserId], references: [id], onDelete: SetNull)
  assignedBy User? @relation("CaseAssignmentMadeBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([toUserId])
}

model Consultation {
  id               String             @id @default(uuid()) @db.Uuid
  clientId         String             @db.Uuid
  caseId           String?            @db.Uuid
  requestedById    String?            @db.Uuid
  assignedToUserId String?            @db.Uuid
  subject          String
  description      String?
  mode             ConsultationMode   @default(CHAT)
  status           ConsultationStatus @default(REQUESTED)
  scheduledAt      DateTime?
  durationMinutes  Int?
  closedAt         DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case          Case?          @relation(fields: [caseId], references: [id], onDelete: SetNull)
  requestedBy   User?          @relation("ConsultationRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  assignedTo    User?          @relation("ConsultationAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages      Message[]
  attachments   Attachment[]
  videoSessions VideoSession[]

  @@index([clientId])
  @@index([caseId])
  @@index([assignedToUserId])
  @@index([status])
  @@index([scheduledAt])
}

// Pesan terenkripsi end-to-end. Server hanya menyimpan ciphertext + metadata.
model Message {
  id             String      @id @default(uuid()) @db.Uuid
  consultationId String      @db.Uuid
  senderId       String?     @db.Uuid
  type           MessageType @default(TEXT)
  body           String?
  ciphertext     String?
  iv             String?
  algorithm      String?
  createdAt      DateTime    @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  sender       User?        @relation("MessageSentBy", fields: [senderId], references: [id], onDelete: SetNull)
  attachments  Attachment[]

  @@index([consultationId])
  @@index([senderId])
  @@index([createdAt])
}

model Attachment {
  id             String               @id @default(uuid()) @db.Uuid
  consultationId String               @db.Uuid
  messageId      String?              @db.Uuid
  uploaderId     String?              @db.Uuid
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String               @unique
  sha256         String
  scanStatus     AttachmentScanStatus @default(PENDING)
  createdAt      DateTime             @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploader     User?        @relation("AttachmentUploadedBy", fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([consultationId])
  @@index([messageId])
  @@index([sha256])
}

model VideoSession {
  id             String             @id @default(uuid()) @db.Uuid
  consultationId String             @db.Uuid
  roomId         String             @unique
  provider       String             @default("webrtc")
  status         VideoSessionStatus @default(SCHEDULED)
  startedAt      DateTime?
  endedAt        DateTime?
  recordingKey   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@index([status])
}

model Regulation {
  id             String            @id @default(uuid()) @db.Uuid
  slug           String            @unique
  type           RegulationType
  number         String?
  year           Int?
  title          String
  jurisdiction   Jurisdiction?
  status         LegalSourceStatus @default(UNKNOWN)
  issuedAt       DateTime?
  effectiveFrom  DateTime?
  effectiveUntil DateTime?
  sourceUrl      String?
  sourceName     String?
  checksum       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  articles           Article[]
  amendmentsMade     Amendment[] @relation("AmendingRegulation")
  amendmentsReceived Amendment[] @relation("AmendedRegulation")

  @@index([type, number, year])
  @@index([jurisdiction])
  @@index([status])
  @@index([effectiveFrom, effectiveUntil])
}

model Article {
  id              String            @id @default(uuid()) @db.Uuid
  regulationId    String            @db.Uuid
  unitKey         String
  articleNumber   String
  paragraphNumber String?
  heading         String?
  content         String
  status          LegalSourceStatus @default(ACTIVE)
  effectiveFrom   DateTime?
  effectiveUntil  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  regulation Regulation  @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  amendments Amendment[]
  citations  Citation[]

  @@unique([regulationId, unitKey])
  @@index([regulationId, articleNumber])
  @@index([status])
  @@index([effectiveFrom, effectiveUntil])
}

model Amendment {
  id                   String        @id @default(uuid()) @db.Uuid
  amendingRegulationId String        @db.Uuid
  amendedRegulationId  String        @db.Uuid
  articleId            String?       @db.Uuid
  type                 AmendmentType @default(AMENDS)
  effectiveAt          DateTime?
  note                 String?
  createdAt            DateTime      @default(now())

  amendingRegulation Regulation @relation("AmendingRegulation", fields: [amendingRegulationId], references: [id], onDelete: Restrict)
  amendedRegulation  Regulation @relation("AmendedRegulation", fields: [amendedRegulationId], references: [id], onDelete: Restrict)
  article            Article?   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([amendingRegulationId, amendedRegulationId, articleId, type])
  @@index([amendedRegulationId])
  @@index([articleId])
  @@index([effectiveAt])
}

model Jurisprudence {
  id                 String              @id @default(uuid()) @db.Uuid
  decisionNumber     String
  courtName          String
  jurisdiction       Jurisdiction
  decisionDate       DateTime
  caseClassification String?
  judges             String[]
  summary            String?
  legalHolding       String?
  fullText           String?
  sourceUrl          String?
  checksum           String?
  status             JurisprudenceStatus @default(UNKNOWN)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  citations Citation[]

  @@unique([courtName, decisionNumber])
  @@index([jurisdiction])
  @@index([decisionDate])
  @@index([status])
}

model Citation {
  id                String                   @id @default(uuid()) @db.Uuid
  articleId         String                   @db.Uuid
  caseId            String?                  @db.Uuid
  jurisprudenceId   String?                  @db.Uuid
  quote             String?
  context           String?
  validationStatus  CitationValidationStatus @default(PENDING)
  validationMessage String?
  validatedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  article       Article        @relation(fields: [articleId], references: [id], onDelete: Restrict)
  case          Case?          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  jurisprudence Jurisprudence? @relation(fields: [jurisprudenceId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([caseId])
  @@index([jurisprudenceId])
  @@index([validationStatus])
}
